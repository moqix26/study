# ============================================
# 短链接服务配置 (Shortlink Service)
# 环境: 测试环境
# ============================================

# ---------- 服务基础 ----------
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080

# ---------- 数据库（MySQL）----------
MYSQL_DSN=root:root123@tcp(127.0.0.1:3307)/study?charset=utf8mb4&parseTime=True&loc=Local

# ---------- 缓存（Redis）----------
REDIS_ADDR=127.0.0.1:6379

# ---------- 业务参数 ----------
CACHE_TTL=1h

# 短链接随机码长度
CODE_LEN=6

# 生成短码冲突时的最大重试次数
MAX_RETRIES=8
